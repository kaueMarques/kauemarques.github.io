---
import { menuLinks, siteConfig } from "@/site.config";

const year = new Date().getFullYear();
---

<footer
	class="mt-auto flex w-full flex-col items-center justify-center gap-y-2 pt-20 pb-4 text-center align-top font-semibold text-gray-600 sm:flex-row sm:justify-center sm:text-xs dark:text-gray-400"
>
	<div class="me-0 sm:me-4">
		&copy; {siteConfig.author}
		{year}.<span class="inline-block">&nbsp;&nbsp;{siteConfig.title}</span>
		<span class="block sm:inline"
			>based in <a
				class="hover:underline"
				href="https://github.com/chrismwilliams/astro-theme-cactus"
				target="_blank">Cactus</a
			></span
		>
	</div>
</footer>
